# Copy to .env and fill in. Only DATABASE_URL and BETTER_AUTH_SECRET are required locally.
DATABASE_URL=postgres://postgres@localhost:5432/bondhu
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-character-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMS (console prints codes in dev; twilio for production)
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Email (optional in dev)
# RESEND_API_KEY=
# EMAIL_FROM="APON <onboarding@resend.dev>"

# Cloudflare R2 uploads (optional)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# 0 = Sunday … 6 = Saturday
MATCHING_DAY=1
